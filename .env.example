# Copy values to server environment OR Streamlit Community Cloud Secrets.
# Never commit real keys. This app reads environment variables / st.secrets,
# it does NOT automatically load a .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BRAVE_SEARCH_API_KEY=
# Voice is separate and optional; no automatic migration of voice providers.
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
